{
  "name": "askdb-server",
  "version": "0.1.0",
  "private": true,
  "description": "AskDB API: turns natural-language questions into safe, read-only SQL",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "query": "tsx --env-file=../.env src/cli/query.ts",
    "index-schema": "tsx --env-file=../.env src/cli/index-schema.ts",
    "search-schema": "tsx --env-file=../.env src/cli/search-schema.ts",
    "ask": "tsx --env-file=../.env src/cli/ask.ts",
    "eval": "tsx --env-file=../.env eval/run.ts",
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "start": "tsx --env-file=../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
