# Copy to .env and replace the values. Never commit .env.

# Database owner (used only to create and seed the database).
POSTGRES_USER=askdb_admin
POSTGRES_PASSWORD=change-me

# Password for the locked-down role the AskDB server uses to run AI-generated SQL.
ASKDB_READONLY_PASSWORD=change-me-too

# The database AskDB answers questions about. Defaults are the bundled Northwind demo;
# point these at your own PostgreSQL (see "Use your own PostgreSQL" in the README).
# Tip: put them in .env.<name> instead and select it with --db <name> (or ASKDB_DB=<name>).
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_NAME=northwind
# DB_READONLY_USER=askdb_readonly
# TLS: disable (local) | verify (remote, certificate checked) | require (encrypted, not checked)
# DB_SSL=disable
# Optional, only used by scripts/verify-db-security.sh. It finds hidden columns by itself;
# columns listed here are also checked, and the check fails if any of them is readable.
# ASKDB_HIDDEN_COLUMNS=users.email,users.password_hash
# Regex of column names that get a "sensitive-looking and readable" warning (has a sensible default).
# ASKDB_SENSITIVE_NAMES=email|password|token|secret|phone|address|birth

# AskDB's own database (schema index, audit log). Defaults to the same server as DB_HOST/DB_PORT.
# When DB_* points at your own database, keep AskDB's data in the bundled container:
# META_DB_HOST=127.0.0.1
# META_DB_PORT=5433

# Password for the role that owns AskDB's own database (schema index, audit log).
ASKDB_APP_PASSWORD=change-me-three

# Claude. Leave ASKDB_ANTHROPIC_BASE_URL empty to use api.anthropic.com directly,
# or set it to an Anthropic-compatible gateway.
ANTHROPIC_API_KEY=sk-ant-...
ASKDB_MODEL=claude-haiku-5-5
ASKDB_ANTHROPIC_BASE_URL=

# Schema-search embeddings: "local" (model runs in Node.js, no key) or
# "gateway" (text-embedding-3-small via ASKDB_ANTHROPIC_BASE_URL).
ASKDB_EMBEDDINGS=local

# HTTP API
PORT=3001
# Daily cap on estimated Claude spend, in USD (protects a public demo).
DAILY_BUDGET_USD=1
RATE_LIMIT_PER_MINUTE=10
# Random value (at least 16 chars) used to anonymise client IPs in the audit log.
ASKDB_CLIENT_ID_SECRET=change-me-to-a-long-random-value
